rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "alexpinto2@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }
    
    function getUserTenantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;
    }

    function isTenantUser(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserTenantId() == tenantId)
      );
    }

    function isTenantAdmin(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         getUserTenantId() == tenantId)
      );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || request.auth.uid == userId || getUserTenantId() == resource.data.tenantId);
      allow create: if isTenantAdmin(request.resource.data.tenantId) && request.resource.data.role != 'superadmin';
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.tenantId == resource.data.tenantId) ||
        (isTenantAdmin(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId && request.resource.data.role != 'superadmin')
      );
      allow delete: if isSuperAdmin() || isTenantAdmin(resource.data.tenantId);
    }

    match /tenants/{tenantId} {
      allow read: if true; // Needed for routing before login
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || isTenantAdmin(tenantId);
    }

    match /clients/{clientId} {
      allow read: if isTenantUser(resource.data.tenantId);
      allow create: if isTenantUser(request.resource.data.tenantId);
      allow update: if isTenantUser(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isTenantUser(resource.data.tenantId);
    }

    match /processes/{processId} {
      allow read: if isTenantUser(resource.data.tenantId);
      allow create: if isTenantUser(request.resource.data.tenantId);
      allow update: if isTenantUser(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isTenantUser(resource.data.tenantId);
    }

    match /events/{eventId} {
      allow read: if isTenantUser(resource.data.tenantId);
      allow create: if isTenantUser(request.resource.data.tenantId);
      allow update: if isTenantUser(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isTenantUser(resource.data.tenantId);
    }

    match /payments/{paymentId} {
      allow read: if isTenantUser(resource.data.tenantId);
      allow create: if isTenantUser(request.resource.data.tenantId);
      allow update: if isTenantUser(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isTenantUser(resource.data.tenantId);
    }

    match /templates/{templateId} {
      allow read: if isTenantUser(resource.data.tenantId);
      allow create: if isTenantUser(request.resource.data.tenantId);
      allow update: if isTenantUser(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isTenantUser(resource.data.tenantId);
    }

    match /customVars/{customVarId} {
      allow read: if isTenantUser(resource.data.tenantId);
      allow create: if isTenantUser(request.resource.data.tenantId);
      allow update: if isTenantUser(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isTenantUser(resource.data.tenantId);
    }
  }
}
